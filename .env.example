# Constellus — Environment Variables
# Copy this file to .env and populate values for local development.
# Never commit .env to git.

# ── Core ──────────────────────────────────────────────────────────────────────
SECRETS_PROVIDER=env          # env | azure_keyvault | aws | gcp | hashicorp_vault
DATABASE_URL=postgresql://constellus:constellus@localhost:5432/constellus
SECRET_KEY=                   # generate with: python -c "import secrets; print(secrets.token_hex(32))"
DEBUG=false

# ── Internal services ─────────────────────────────────────────────────────────

# Scanner worker sidecar (nuclei + naabu) — shared secret between backend and
# the scanner-worker container. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SCANNER_INTERNAL_TOKEN=
# SCANNER_URL=http://scanner-worker:8001  # default; override if running on a different host

# ── Connectors ────────────────────────────────────────────────────────────────

# Cloudflare
CLOUDFLARE_API_TOKEN=

# Wiz
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
WIZ_API_ENDPOINT=

# FortiManager Connector (sidecar)
FORTIMANAGER_CONNECTOR_URL=
FORTIMANAGER_CONNECTOR_API_KEY=

# Tenable
TENABLE_API_KEY=
TENABLE_API_SECRET=

# ── Discovery ─────────────────────────────────────────────────────────────────

# Certspotter (Certificate Transparency log enumeration)
# Free signup at https://sslmate.com/signup?for=certspotter_api raises the
# rate limit from 100 req/hr to 1000 req/hr. Leaving this unset still works
# but caps the CT refresher much lower.
CERTSPOTTER_API_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
# Mailtrap (sandbox for dev — inbox_id configured via admin UI)
MAILTRAP_API_TOKEN=
