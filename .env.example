# Constellus — Environment Variables
# Copy this file to .env and populate values for local development.
# Never commit .env to git.
#
# Two consumers read this file, and they read it differently:
#   - The "Core" keys below are declared fields on Settings (app/core/config.py).
#     Settings validates them and rejects a bad value.
#   - Everything else — internal-service and connector credentials — is read on
#     demand via app.core.secrets.get_secret(), which honours SECRETS_PROVIDER.
#     Settings never sees these keys and must not declare them (planning#157);
#     adding a connector means adding a key HERE plus an env_key_map entry on
#     the connector, never a new field on Settings.

# ── Core ──────────────────────────────────────────────────────────────────────
SECRETS_PROVIDER=env          # env | azure_keyvault | aws | gcp | hashicorp_vault
DATABASE_URL=postgresql://constellus:constellus@localhost:5432/constellus
SECRET_KEY=                   # generate with: python -c "import secrets; print(secrets.token_hex(32))"
DEBUG=false
# LLM_DATA_POLICY=strict       # strict | dev_permissive — strict is the default and the
#                               # ONLY value for any shared/prod deployment: every OpenRouter
#                               # request carries zdr=true + data_collection=deny, no silent
#                               # fallback (planning#140, R1). dev_permissive lets a local dev
#                               # machine route to cheap/free endpoints that may retain or
#                               # train on prompts — pre-close M&A targets stay strict
#                               # regardless of this setting (app.services.posture.
#                               # is_passive_only overrides it per call). Changing this needs
#                               # `docker compose up -d backend` (a container recreate —
#                               # `restart` does NOT re-read env_file).

# ── Internal services ─────────────────────────────────────────────────────────

# Scanner worker sidecar (nuclei + naabu) — shared secret between backend and
# the scanner-worker container. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SCANNER_INTERNAL_TOKEN=
# SCANNER_URL=http://scanner-worker:8001  # default; override if running on a different host

# ── Connectors ────────────────────────────────────────────────────────────────

# Cloudflare
CLOUDFLARE_API_TOKEN=

# Wiz
WIZ_CLIENT_ID=
WIZ_CLIENT_SECRET=
WIZ_API_ENDPOINT=

# FortiManager Connector (sidecar)
FORTIMANAGER_CONNECTOR_URL=
FORTIMANAGER_CONNECTOR_API_KEY=

# Tenable
TENABLE_API_KEY=
TENABLE_API_SECRET=

# ── Discovery ─────────────────────────────────────────────────────────────────

# Certspotter (Certificate Transparency log enumeration)
# Free signup at https://sslmate.com/signup?for=certspotter_api raises the
# rate limit from 100 req/hr to 1000 req/hr. Leaving this unset still works
# but caps the CT refresher much lower.
CERTSPOTTER_API_TOKEN=

# ── Email ─────────────────────────────────────────────────────────────────────
# Mailtrap (sandbox for dev — inbox_id configured via admin UI)
MAILTRAP_API_TOKEN=
